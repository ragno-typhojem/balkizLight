# Internal testing only. Import into Preview/Development, not Production.
# Fill the placeholder; keep the existing GROQ_API_KEY in Vercel.
AI_PROVIDER=nvidia
AI_FALLBACK=groq
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_ACCESS_MODE=evaluation
NVIDIA_SCIENCE_MODEL=openai/gpt-oss-20b
