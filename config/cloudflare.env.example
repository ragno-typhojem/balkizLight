# Fill only the two placeholders. Keep your existing GROQ_API_KEY in Vercel.
# Import this file into Production/Preview, then redeploy.
# The Cloudflare account must actually use Workers Free, not Workers Paid.
AI_PROVIDER=cloudflare
AI_FALLBACK=groq
CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
CLOUDFLARE_API_KEY=YOUR_WORKERS_AI_API_TOKEN
CLOUDFLARE_FREE_PLAN=1
CLOUDFLARE_SCIENCE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_ECONOMY_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Application caps, not Cloudflare's neuron quota.
CLOUDFLARE_RPM=30
CLOUDFLARE_RPD=1000
CLOUDFLARE_TPM=40000
CLOUDFLARE_TPD=240000
