# Vercel Environment Variables: add your own key on the server.
GROQ_API_KEY=
GROQ_SCIENCE_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Use the actual limits shown for your Groq organization/model.
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
QUOTA_HEADROOM=0.85
MAX_CONCURRENT=4
USER_RPM=6
# Optional shared reservation across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUOTA_NAMESPACE=balkiz:v2
REQUIRE_SHARED_LIMITS=0
