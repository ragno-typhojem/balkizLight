# Vercel Environment Variables: add your own key on the server.
AI_PROVIDER=groq
AI_FALLBACK=none
GROQ_API_KEY=
GROQ_SCIENCE_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_ECONOMY_MODEL=openai/gpt-oss-20b
# Use the actual limits shown for your Groq organization/model.
GROQ_RPM=30
GROQ_RPD=1000
GROQ_TPM=8000
GROQ_TPD=200000
QUOTA_HEADROOM=0.85
MAX_CONCURRENT=4
USER_RPM=6
# Optional NVIDIA-hosted NIM. Leave AI_PROVIDER=groq for the existing deployment.
# Free NVIDIA access is for testing/evaluation, not a production entitlement.
NVIDIA_API_KEY=
NVIDIA_SCIENCE_MODEL=openai/gpt-oss-20b
NVIDIA_FAST_MODEL=openai/gpt-oss-20b
NVIDIA_ECONOMY_MODEL=openai/gpt-oss-20b
NVIDIA_ACCESS_MODE=evaluation
# Only set production-authorized after you actually obtain production access.
# These are conservative application caps; use the limits for your NVIDIA account.
NVIDIA_RPM=10
NVIDIA_RPD=1000
NVIDIA_TPM=20000
NVIDIA_TPD=200000
# Optional production-compatible Workers AI on a genuinely Workers Free account.
# Copy config/cloudflare.env.example for the recommended setup with Groq backup.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_FREE_PLAN=1
CLOUDFLARE_SCIENCE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_ECONOMY_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_RPM=30
CLOUDFLARE_RPD=1000
CLOUDFLARE_TPM=40000
CLOUDFLARE_TPD=240000
# Optional shared reservation across Vercel instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUOTA_NAMESPACE=balkiz:v2
REQUIRE_SHARED_LIMITS=0
